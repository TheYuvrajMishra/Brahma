# =================================================================
# BRAHMA PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# =================================================================

# -----------------------------------------------------------------
# Core Application Settings
# -----------------------------------------------------------------
PORT=3005

# Public domain or IP of your VPS (used for OAuth callbacks and CORS setup)
# Replace with your actual domain or IP address, e.g. https://brahma.yourdomain.com or http://123.45.67.89
APP_BASE_URL=http://localhost:3005

# -----------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------
# When using Docker Compose, the host service name is 'mongodb'
MONGO_URI=mongodb://mongodb:27017/brahma

# -----------------------------------------------------------------
# LLM Provider Credentials
# -----------------------------------------------------------------
# URL endpoint for your LLM provider / OpenAI-compatible API gateway
LLM_BASE_URL=http://localhost:3001/v1/chat/completions
LLM_MODEL=gpt-4o
LLM_API_KEY=your_llm_api_key_here

# -----------------------------------------------------------------
# Discord Adapter Configuration
# -----------------------------------------------------------------
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_APP_ID=your_discord_app_id_here
DISCORD_PUBLIC_KEY=your_discord_public_key_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# -----------------------------------------------------------------
# Gmail Adapter Credentials (OAuth 2.0)
# -----------------------------------------------------------------
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token_here
# Production callback URL (must match the URI authorized in Google Cloud Console)
GMAIL_REDIRECT_URI=http://localhost:3005/api/auth/google/callback
GMAIL_WATCH_ADDRESS=your_email@gmail.com

# -----------------------------------------------------------------
# Voice / Speech Credentials (ElevenLabs)
# -----------------------------------------------------------------
ELEVANLABS_API_KEY=your_elevenlabs_api_key_here
